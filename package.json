{
  "name": "@seenty/guarda",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seentyhq/guarda.git"
  },
  "homepage": "https://github.com/seentyhq/guarda#readme",
  "bugs": {
    "url": "https://github.com/seentyhq/guarda/issues"
  },
  "description": "Local, account-free check of lockfiles and CI workflows against curated supply-chain advisories, plus secrets detection.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "guarda": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "NETWORK.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "dev": "tsx src/bin.ts",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "build-feed": "tsx scripts/build-feed.ts",
    "check-advisories": "tsx scripts/check-advisories.ts"
  },
  "dependencies": {
    "@renovatebot/pep440": "^5.0.1",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "supply-chain",
    "security",
    "malicious-packages",
    "lockfile",
    "github-actions",
    "secrets",
    "sbom",
    "osv",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
